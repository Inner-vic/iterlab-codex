# Share source, never the current user's workbench. Unknown root entries are
# local by default; review this list when adding a new source directory.
/*
!/.gitignore
!/.gitattributes
!/app.cmd
!/AGENTS.md
!/LICENSE
!/NOTICE.md
!/README.md
!/package.json
!/lab/
!/static/
!/frontend/
!/methods/
!/skills/
!/tests/
!/scripts/
!/docs/

# Deployment helpers and runtime bridges only. Historical live acceptance
# drivers contain personal task IDs, source locations and operator decisions.
/scripts/*
!/scripts/open-frontend.ps1
!/scripts/start.ps1
!/scripts/stop.ps1
!/scripts/resolve-python.ps1
!/scripts/dependencies.ps1
!/scripts/bootstrap.py
!/scripts/setup.ps1
!/scripts/run-quiet.ps1
!/scripts/install-lpai.ps1
!/scripts/lpai_sdk_bridge.py
!/scripts/lpai_asset_bridge.py
!/scripts/platform_login.py
!/scripts/lpai_task_files.py
!/scripts/probe_cloud_outputs.py
!/scripts/probe_task_output_identity.py
!/scripts/exploration-test-loader.mjs
!/scripts/verify_goal_loop.py
!/scripts/source_bundle.py
!/scripts/study_demo.py
!/scripts/check_docs.py
!/scripts/verify_research_methods.py
!/scripts/storage.py
!/scripts/storage_audit.py
!/scripts/snapshot.py

# Share maintained technical documents; keep screenshots, run receipts,
# progress diaries and other historical notes on this computer.
/docs/*
!/docs/README.md
!/docs/repository-audit.md
!/docs/sharing-and-deployment.md
